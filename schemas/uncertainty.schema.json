{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uncertainty.schema.json",
  "title": "Uncertainty Register Entry",
  "description": "Something the agent could not resolve. Every entry must name an affected scope and a next action, so that 'unknown' never silently becomes 'fine'.",
  "type": "object",
  "required": ["id", "timestamp", "question", "status", "impact", "affected_scope", "next_action", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/uncertaintyId" },
    "timestamp": { "$ref": "common.schema.json#/definitions/timestamp" },
    "session_id": { "$ref": "common.schema.json#/definitions/sessionId" },
    "question": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": [
        "unresolved", "blocked", "deferred", "user-input-required",
        "environment-unavailable", "ambiguous-requirement", "insufficient-evidence",
        "external-dependency", "interrupted", "future-case", "resolved"
      ]
    },
    "impact": { "type": "string", "minLength": 3 },
    "affected_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Test categories, components or goal IDs that cannot be completed while this stands."
    },
    "blocks_categories": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/testCategory" }
    },
    "next_action": { "type": "string", "minLength": 3 },
    "owner": { "type": "string", "enum": ["agent", "user", "external"] },
    "raised_by_execution": { "$ref": "common.schema.json#/definitions/executionId" },
    "evidence": { "$ref": "common.schema.json#/definitions/evidenceRefs" },
    "workaround_applied": { "type": "string" },
    "independent_work_continued": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What the agent did anyway. Proves the blocker did not stall unrelated progress."
    },
    "resolution": {
      "type": "object",
      "properties": {
        "resolved_at": { "$ref": "common.schema.json#/definitions/timestamp" },
        "answer": { "type": "string" },
        "resolved_by": { "type": "string", "enum": ["agent", "user", "environment-change", "external"] },
        "evidence": { "$ref": "common.schema.json#/definitions/evidenceRefs" }
      },
      "additionalProperties": false
    },
    "provenance": { "$ref": "common.schema.json#/definitions/provenance" }
  },
  "additionalProperties": false
}
