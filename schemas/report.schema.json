{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report.schema.json",
  "title": "Testing Report",
  "description": "Machine-readable form of the testing report. The Markdown report is rendered FROM this, never written by hand, so prose can never outrun the data.",
  "type": "object",
  "required": [
    "report_id",
    "generated_at",
    "session_id",
    "executive_summary",
    "execution_summary",
    "integrity",
    "provenance"
  ],
  "properties": {
    "report_id": {
      "$ref": "common.schema.json#/definitions/reportId"
    },
    "report_version": {
      "$ref": "common.schema.json#/definitions/semver"
    },
    "generated_at": {
      "$ref": "common.schema.json#/definitions/timestamp"
    },
    "session_id": {
      "$ref": "common.schema.json#/definitions/sessionId"
    },
    "supersedes": {
      "$ref": "common.schema.json#/definitions/reportId"
    },
    "git": {
      "$ref": "common.schema.json#/definitions/gitRef"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 over this record's own content with this field excluded, set by the renderer and printed in the rendered footer. Its purpose is `ast report verify`: a hand-written or hand-edited report carries no valid digest. Optional so records from before this field existed remain valid."
    },
    "executive_summary": {
      "type": "object",
      "required": [
        "headline",
        "overall_status"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "overall_status": {
          "$ref": "common.schema.json#/definitions/status"
        },
        "confidence": {
          "$ref": "common.schema.json#/definitions/confidence"
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what_was_not_tested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_applicable_summary": {
          "type": "object",
          "description": "Categories judged not applicable, grouped by reason. Grouped rather than listed because thirty repetitions of one sentence bury the handful of items a reader needs; the full per-category list stays in applicable_categories.",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "reason",
                  "count",
                  "categories"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repository_context": {
      "type": "object"
    },
    "quarantined_tests": { "type": "array", "items": { "type": "string" }, "description": "Tests the flakiness engine proved flaky; their passes are excluded from what was proven." },
    "plan_progress": {
      "type": "object",
      "description": "Every scenario committed this session beside what ran, judged by the same rule as validate --final.",
      "required": ["committed", "covered", "remaining", "scenarios"],
      "properties": {
        "plan_id": { "type": ["string", "null"] },
        "committed": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "ran": { "type": "integer", "minimum": 0 },
        "held": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "obligation", "covered", "outcome"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "obligation": { "type": "string" },
              "category": { "type": ["string", "null"] },
              "covered": { "type": "boolean" },
              "held": { "type": "boolean" },
              "outcome": { "type": "string" },
              "execution_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "authored_tests": {
      "type": "array",
      "description": "Test files written or changed this session, and whether an execution ran them.",
      "items": {
        "type": "object",
        "required": ["file", "ran"],
        "properties": {
          "file": { "type": "string" },
          "ran": { "type": "boolean" },
          "held": { "type": "boolean" },
          "execution_id": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"] }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_assessment": {
      "$ref": "testing-plan.schema.json#/definitions/riskAssessment"
    },
    "applicable_categories": {
      "type": "array",
      "items": {
        "$ref": "testing-plan.schema.json#/definitions/applicabilityRow"
      }
    },
    "execution_summary": {
      "type": "object",
      "required": [
        "by_status"
      ],
      "properties": {
        "by_status": {
          "type": "object",
          "patternProperties": {
            "^[A-Z_]+$": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "executions": {
          "type": "integer",
          "minimum": 0
        },
        "test_cases": {
          "type": "integer",
          "minimum": 0
        },
        "total_duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "detailed_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "$ref": "common.schema.json#/definitions/evidenceId"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "grade": {
            "type": ["string", "null"],
            "enum": ["anchored", "asserted", null]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/findingId"
      }
    },
    "external_writes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "system",
          "action",
          "confirmed"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "result_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean",
            "description": "True ONLY when the provider returned a success response. Never set optimistically."
          },
          "authorised_by": {
            "type": "string",
            "enum": [
              "user-explicit",
              "policy-default",
              "not-authorised"
            ]
          },
          "decision_id": {
            "$ref": "common.schema.json#/definitions/decisionId"
          }
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "automation_added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "test_count": {
            "type": "integer",
            "minimum": 0
          },
          "converted_from": {
            "$ref": "common.schema.json#/definitions/executionId"
          },
          "quality_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "blocked_work": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deferred_work": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interrupted_work": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncertainty_register": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/uncertaintyId"
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_history": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/decisionId"
      }
    },
    "metrics": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "required": [
        "unevidenced_pass_claims",
        "false_confidence_rate",
        "checks_run"
      ],
      "description": "Self-audit of this report. A report that cannot state its own false-confidence rate is not trustworthy.",
      "properties": {
        "unevidenced_pass_claims": {
          "type": "integer",
          "minimum": 0
        },
        "false_confidence_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_auditor_run": {
          "type": "boolean",
          "description": "Whether the evidence-auditor subagent recorded an independent review of this session's claims. False does not mean the report is wrong -- it means the one check built to catch what the mechanical evidence gate cannot has not run."
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "common.schema.json#/definitions/provenance"
    },
    "finding_details": {
      "type": "array",
      "description": "Findings embedded in full, not merely referenced by ID. A report whose most important section is a list of identifiers forces the reader to look each one up, which in practice means they do not -- and a stored report should stay readable long after the state directory has moved on.",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "title",
          "severity",
          "kind",
          "confidence"
        ],
        "properties": {
          "finding_id": {
            "$ref": "common.schema.json#/definitions/findingId"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "$ref": "common.schema.json#/definitions/severity"
          },
          "confidence": {
            "$ref": "common.schema.json#/definitions/confidence"
          },
          "verification": {
            "type": "object",
            "description": "Computed by the engine: confirmed (a linked repro run failed on a product-defect assertion with real evidence), held, refuted, rejected, unverified or duplicate.",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["confirmed", "held", "refuted", "rejected", "unverified", "duplicate"] },
              "execution_id": { "type": ["string", "null"] },
              "repro": { "type": ["string", "null"] },
              "reason": { "type": "string" }
            }
          },
          "component": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "reproducible": {
            "type": "string"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "$ref": "common.schema.json#/definitions/evidenceRefs"
          },
          "recommended_action": {
            "type": "string"
          },
          "duplicate_of": {
            "$ref": "common.schema.json#/definitions/findingId"
          },
          "external_refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty_details": {
      "type": "array",
      "description": "Open questions embedded, not referenced. Same principle as finding_details.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "question",
          "next_action"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/uncertaintyId"
          },
          "status": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "affected_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolved": {
            "type": "boolean"
          },
          "impact": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean",
            "description": "True when this uncertainty's status is one that actually stalls work (blocked, user-input-required, environment-unavailable, external-dependency) -- see uncertainty-register's BLOCKING_STATUSES. Backs the report's 'Unblock these' section."
          },
          "raised_by_execution": {
            "anyOf": [
              { "$ref": "common.schema.json#/definitions/executionId" },
              { "type": "null" }
            ]
          },
          "user_quote": { "type": "string", "description": "The user's words a user-owned hold relies on." },
          "user_quote_source": { "type": "string", "enum": ["request", "hook", "agent", "not found"], "description": "Where the quote was verified: the session request, a hook-recorded prompt, the agent's own transcription, or nowhere." }
        },
        "additionalProperties": false
      }
    },
    "decision_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "question",
          "selected_option",
          "confidence"
        ],
        "properties": {
          "decision_id": {
            "$ref": "common.schema.json#/definitions/decisionId"
          },
          "question": {
            "type": "string"
          },
          "selected_option": {
            "type": "string"
          },
          "confidence": {
            "$ref": "common.schema.json#/definitions/confidence"
          },
          "reversible": {
            "type": "boolean"
          },
          "top_reason": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
