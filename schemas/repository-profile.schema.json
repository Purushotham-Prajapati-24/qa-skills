{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repository-profile.schema.json",
  "title": "Repository Profile",
  "description": "Structured understanding of a repository, produced by the repository-intelligence skill. Every claim carries how it was established, because filename-based guesses and file-content reads are not equally trustworthy.",
  "type": "object",
  "required": ["profile_version", "generated_at", "repository", "provenance"],
  "properties": {
    "profile_version": { "$ref": "common.schema.json#/definitions/semver" },
    "generated_at": { "$ref": "common.schema.json#/definitions/timestamp" },
    "repository": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "name": { "type": "string" },
        "remote": { "type": "string" },
        "default_branch": { "type": "string" },
        "git": { "$ref": "common.schema.json#/definitions/gitRef" },
        "monorepo": { "type": "boolean" },
        "workspaces": { "type": "array", "items": { "type": "string" } },
        "size": {
          "type": "object",
          "properties": {
            "files": { "type": "integer", "minimum": 0 },
            "source_files": { "type": "integer", "minimum": 0 },
            "loc_estimate": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "description": "e.g. 'modular monolith', 'spa + rest api', 'microservices'." },
        "frontend": { "$ref": "#/definitions/tier" },
        "backend": { "$ref": "#/definitions/tier" },
        "data": { "$ref": "#/definitions/tier" },
        "entrypoints": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "language", "runtime", "package-manager", "framework", "library",
              "database", "queue", "cache", "auth", "ci", "container",
              "iac", "observability", "test-framework", "browser-tool", "llm", "other"
            ]
          },
          "version": { "type": "string" },
          "confidence": { "$ref": "common.schema.json#/definitions/confidence" },
          "epistemic_class": { "$ref": "common.schema.json#/definitions/epistemicClass" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Concrete file paths / lines that establish this. 'It's probably React' is not evidence."
          }
        },
        "additionalProperties": false
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["rest", "graphql", "grpc", "websocket", "cli", "event", "other"] },
          "spec_file": { "type": "string" },
          "route_count": { "type": "integer", "minimum": 0 },
          "sample_routes": { "type": "array", "items": { "type": "string" } },
          "auth_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "testing_frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "levels": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/testCategory" } },
          "config_files": { "type": "array", "items": { "type": "string" } },
          "run_command": { "type": "string" },
          "test_globs": { "type": "array", "items": { "type": "string" } },
          "verified_runnable": {
            "type": "boolean",
            "description": "True only if the command was actually executed successfully at least once."
          }
        },
        "additionalProperties": false
      }
    },
    "existing_coverage": {
      "type": "object",
      "properties": {
        "test_file_count": { "type": "integer", "minimum": 0 },
        "test_case_estimate": { "type": "integer", "minimum": 0 },
        "coverage_report": { "type": "string" },
        "line_coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "by_category": {
          "type": "object",
          "patternProperties": {
            "^[a-z-]+$": { "type": "string", "enum": ["none", "minimal", "partial", "substantial", "unknown"] }
          }
        },
        "measured": { "type": "boolean", "description": "False means these numbers are counts of files, not a coverage run." }
      },
      "additionalProperties": false
    },
    "critical_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "why"],
        "properties": {
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" },
          "business_criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "data_sensitivity": { "type": "string", "enum": ["none", "internal", "personal", "financial", "regulated"] }
        },
        "additionalProperties": false
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["saas", "payment", "email", "sms", "storage", "llm", "auth-provider", "analytics", "other"] },
          "reachable_in_test_env": { "type": "string", "enum": ["yes", "no", "mocked", "unknown"] },
          "side_effects": { "type": "string", "enum": ["none", "reversible", "irreversible", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "ci_cd": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "workflow_files": { "type": "array", "items": { "type": "string" } },
        "runs_tests": { "type": "boolean" },
        "test_jobs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "environment_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint"],
        "properties": {
          "constraint": { "type": "string" },
          "blocks": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/testCategory" } },
          "workaround": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factor", "note"],
        "properties": {
          "factor": { "type": "string" },
          "note": { "type": "string" },
          "level": { "$ref": "common.schema.json#/definitions/riskLevel" }
        },
        "additionalProperties": false
      }
    },
    "documentation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What the profiler could NOT determine. An empty array must mean 'nothing unknown', not 'did not look'."
    },
    "provenance": { "$ref": "common.schema.json#/definitions/provenance" }
  },
  "additionalProperties": false,
  "definitions": {
    "tier": {
      "type": "object",
      "properties": {
        "present": { "type": "boolean" },
        "stack": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
