{
  "name": "autonomous-software-testing",
  "version": "0.6.0",
  "description": "An evidence-driven, extensible autonomous software testing agent skill system for Claude Code.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "ast": "./bin/ast.mjs"
  },
  "scripts": {
    "ast": "node ./bin/ast.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "validate": "node ./scripts/validate-repo.mjs",
    "install-skills": "node ./scripts/install-skills.mjs",
    "check": "npm run validate && npm test"
  },
  "dependencies": {},
  "devDependencies": {}
}
