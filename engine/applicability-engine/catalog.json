    "existing-tests": "Already has an automated test suite",
    "browser-tooling": "Already has browser automation tooling",
    "component-framework": "Uses a component framework with a testable unit boundary",
    "responsive": "Targets more than one viewport class",
    "multi-browser": "Targets more than one browser engine"
