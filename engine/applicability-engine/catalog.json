    "http-api": "Exposes an HTTP API consumed by something else",
    "graphql": "Exposes a GraphQL schema",
    "grpc": "Exposes gRPC services",
    "public-contract": "An API contract other teams or customers depend on",
    "database": "Reads or writes a persistent datastore",
    "migrations": "Contains schema migration files",
    "cache": "Uses a caching layer",
    "queue": "Uses a message queue or event bus",
    "auth": "Implements authentication",
    "authz": "Implements authorisation / permissions",
    "sessions": "Manages user sessions",
    "user-input": "Accepts untrusted input",
    "secrets": "Handles credentials or secret material",
    "third-party-deps": "Has an external dependency manifest",
    "external-integration": "Calls third-party services",
    "payments": "Handles money movement",
    "pii": "Processes personal data",
    "i18n": "Has localisation resources",
    "concurrency": "Has concurrent or async execution paths",
    "observability": "Emits logs, metrics or traces",
    "ci": "Has CI workflows",
    "container": "Ships container or IaC definitions",
    "deploy-config": "Has deployment configuration",
    "rollback-path": "Has a documented or scripted rollback",
    "llm": "Calls an LLM",
    "rag": "Implements retrieval-augmented generation",
    "agent-tools": "Implements agent tool-calling",
